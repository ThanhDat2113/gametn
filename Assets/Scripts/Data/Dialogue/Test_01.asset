  - character: {fileID: 11400000, guid: 86527f61d9b6c7843bf8154ad34324e2, type: 2}
    position: 0
    emotionKey: 
    text: "M\u1ED9t n\u1EAFm \u0111\u1EA5u gi\xE1ng xu\u1ED1ng \u0111\u1EA7u l\xE0m
      cho t\xF4i \u0111au \u0111i\u1EBFng. "
    textSpeed: 0
    portraitEffect: 0
    effectDuration: 0
    backgroundSprite: {fileID: 21300000, guid: 08bd7c046bacb1143878bcce1e8f3d20, type: 3}
