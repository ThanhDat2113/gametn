  lines:
  - character: {fileID: 11400000, guid: 4155231e218c212448c7c9c628cd4fb0, type: 2}
    position: 0
    emotionKey: 
    text: "Nghe \u0111\xE2y, Aleus."
    textSpeed: 0
    portraitEffect: 0
    effectDuration: 0
    backgroundSprite: {fileID: 21300000, guid: 28ed31020cf630a45aa8d5d709978ffa, type: 3}
    backgroundEffect: 0
    backgroundEffectDuration: 0
    voiceClip: {fileID: 0}
    textSound: {fileID: 0}
    otherCharacters: []
  - character: {fileID: 11400000, guid: 4155231e218c212448c7c9c628cd4fb0, type: 2}
    position: 0
    emotionKey: 
    text: "Chi\u1EBFn binh d\xF9 cho c\xF3 d\u0169ng m\xE3nh \u0111\u1EBFn \u0111\xE2u,
      n\u1EBFu thi\u1EBFu \u0111i s\u1EF1 kh\xF4n ngoan th\xEC c\u0169ng ch\u1EC9
      l\xE0 k\u1EBB v\xF4 d\u1EE5ng m\xE0 th\xF4i."
    textSpeed: 0
    portraitEffect: 0
    effectDuration: 0
    backgroundSprite: {fileID: 21300000, guid: 28ed31020cf630a45aa8d5d709978ffa, type: 3}
    backgroundEffect: 0
    backgroundEffectDuration: 0
    voiceClip: {fileID: 0}
    textSound: {fileID: 0}
    otherCharacters: []
  - character: {fileID: 11400000, guid: 4155231e218c212448c7c9c628cd4fb0, type: 2}
    position: 0
    emotionKey: 
    text: "Ph\u01B0\u01A1ng B\u1EAFc ch\xFAng ta c\u1EA7n nh\u1EEFng chi\u1EBFn binh
      m\u1EA1nh m\u1EBD, nh\u01B0ng c\u0169ng kh\xF4ng th\u1EC3 thi\u1EBFu \u0111i
      nh\u1EEFng l\xE3nh \u0111\u1EA1o xu\u1EA5t ch\xFAng."
    textSpeed: 0
    portraitEffect: 0
    effectDuration: 0
    backgroundSprite: {fileID: 21300000, guid: 28ed31020cf630a45aa8d5d709978ffa, type: 3}
    backgroundEffect: 0
    backgroundEffectDuration: 0
    voiceClip: {fileID: 0}
    textSound: {fileID: 0}
    otherCharacters: []
  - character: {fileID: 11400000, guid: 4155231e218c212448c7c9c628cd4fb0, type: 2}
    position: 0
    emotionKey: 
    text: "V\u1EADy n\xEAn \u0111\u1EEBng bu\u1ED3n, con trai c\u1EE7a ta."
    textSpeed: 0
    portraitEffect: 0
    effectDuration: 0
    backgroundSprite: {fileID: 21300000, guid: 28ed31020cf630a45aa8d5d709978ffa, type: 3}
    backgroundEffect: 0
    backgroundEffectDuration: 0
    voiceClip: {fileID: 0}
    textSound: {fileID: 0}
    otherCharacters: []
  - character: {fileID: 11400000, guid: 4155231e218c212448c7c9c628cd4fb0, type: 2}
    position: 0
    emotionKey: 
    text: "D\xF9 cho con kh\xF4ng c\xF3 s\u1EE9c m\u1EA1nh, con v\u1EABn c\xF3 th\u1EC3
      bi\u1EBFn b\u1ED9 n\xE3o tr\u1EDF th\xE0nh th\u1EE9 v\u0169 kh\xED l\u1EE3i
      h\u1EA1i nh\u1EA5t."
    textSpeed: 0
    portraitEffect: 0
    effectDuration: 0
    backgroundSprite: {fileID: 21300000, guid: 28ed31020cf630a45aa8d5d709978ffa, type: 3}
    backgroundEffect: 0
    backgroundEffectDuration: 0
    voiceClip: {fileID: 0}
    textSound: {fileID: 0}
    otherCharacters: []
  - character: {fileID: 11400000, guid: 4155231e218c212448c7c9c628cd4fb0, type: 2}
    position: 0
    emotionKey: 
    text: "H\xE3y h\u1ECDc t\u1EADp ch\u0103m ch\u1EC9 t\u1EA1i ph\u01B0\u01A1ng
      T\xE2y. Sau \u0111\xF3 tr\u1EDF v\u1EC1 \u0111\xE2y, v\xE0 s\u1EED d\u1EE5ng
      tr\xED th\xF4ng minh c\u1EE7a con \u0111\u1EC3 ph\u1EE5c v\u1EE5 ph\u01B0\u01A1ng
      B\u1EAFc."
    textSpeed: 0
    portraitEffect: 0
    effectDuration: 0
    backgroundSprite: {fileID: 21300000, guid: 28ed31020cf630a45aa8d5d709978ffa, type: 3}
    backgroundEffect: 0
    backgroundEffectDuration: 0
    voiceClip: {fileID: 0}
    textSound: {fileID: 0}
    otherCharacters: []
  - character: {fileID: 11400000, guid: 4155231e218c212448c7c9c628cd4fb0, type: 2}
    position: 0
    emotionKey: 
    text: "\u0110\u1EEBng l\xE0m ta th\u1EA5t v\u1ECDng, Aleus."
    textSpeed: 0
    portraitEffect: 0
    effectDuration: 0
    backgroundSprite: {fileID: 21300000, guid: 28ed31020cf630a45aa8d5d709978ffa, type: 3}
