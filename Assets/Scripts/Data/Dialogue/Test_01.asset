  - character: {fileID: 11400000, guid: 86527f61d9b6c7843bf8154ad34324e2, type: 2}
    position: 0
    emotionKey: 
    text: "T\xF4i sau \u0111\xF3 ng\u1EA9ng \u0111\u1EA7u l\xEAn \u0111\u1EC3 b\u1EAFt
      g\u1EB7p \u0111\xF4i m\u1EAFt c\u1EE7a ng\u01B0\u1EDDi v\u1EEBa \u0111\xE1nh
      m\xECnh."
    textSpeed: 0
