--- !u!114 &421630353
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 421630351}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "BI\xCAN NI\xCAN S\u1EEC PH\u01AF\u01A0NG B\u1EAEC\r\nChronicles of The
    North\r\n\u2014 \u2022 \u2014\r\nM\u1ED9t s\u1EA3n ph\u1EA9m c\u1EE7a nh\xF3m
    HEX\r\nTr\u01B0\u1EDDng Cao \u0111\u1EB3ng FPT Polytechnic\r\n\u2014 \u2022 \u2014\r\n\"H\xE0nh
    tr\xECnh tr\u1EA3 th\xF9 \u0111\xE3 k\u1EBFt th\xFAc...\r\n...nh\u01B0ng c\xE2u
    chuy\u1EC7n v\u1EC1 Eugeo v\xE0 nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n\r\n...ch\u1EC9
    m\u1EDBi b\u1EAFt \u0111\u1EA7u.\"\r\n\u2014 \u2022 \u2014\r\nDANH S\xC1CH TH\xC0NH
    VI\xCAN NH\xD3M\n\u2014 \u2022 \u2014\r\n \u0110\u1EA0O DI\u1EC4N S\xC1NG T\u1EA0O
    & TR\u01AF\u1EDENG NH\xD3M\r\nV\u0169 Th\xE0nh \u0110\u1EA1t (PS45894)\n\u2014
    \u2022\r\nVi\u1EBFt k\u1ECBch b\u1EA3n & c\u1ED1t truy\u1EC7n\r\nThi\u1EBFt k\u1EBF
    h\u1ED9p tho\u1EA1i\r\nThi\u1EBFt k\u1EBF UI/UX (Menu, Inventory, Team, Items)\r\nX\xE2y
    d\u1EF1ng h\u1EC7 th\u1ED1ng nhi\u1EC7m v\u1EE5 & s\u1EF1 ki\u1EC7n\r\nThi\u1EBFt
    k\u1EBF y\u1EBFu t\u1ED1 t\u01B0\u01A1ng t\xE1c m\xF4i tr\u01B0\u1EDDng\r\n\u2014
    \u2022 \u2014\r\nTHI\u1EBET K\u1EBE TH\u1EBE GI\u1EDAI & M\xD4I TR\u01AF\u1EDCNG\r\nK'Nguy\u1EC5n
    Gia Huy (PS45809)\n\u2014 \u2022 \r\nThi\u1EBFt k\u1EBF b\u1EA3n \u0111\u1ED3\r\nThi\u1EBFt
    k\u1EBF Main Menu \r\nX\xE2y d\u1EF1ng h\u1EC7 th\u1ED1ng Camera & Player Movement\r\nThi\u1EBFt
    k\u1EBF h\u1EC7 th\u1ED1ng nh\u1EA1c n\u1EC1n (BGM)\r\nX\xE2y d\u1EF1ng NPC &
    Qu\xE1i v\u1EADt tr\xEAn map\r\nThi\u1EBFt k\u1EBF Minimap & Quest Marker\r\n\u2014
    \u2022 \u2014\r\nGAMEPLAY & THI\u1EBET K\u1EBE NH\xC2N V\u1EACT\r\nPh\u1EA1m
    Ho\xE0i Ph\u1EA5t (PS45846)\n\u2014 \u2022 \r\nThi\u1EBFt k\u1EBF & c\xE2n b\u1EB1ng
    h\u1EC7 th\u1ED1ng nh\xE2n v\u1EADt\r\nThi\u1EBFt k\u1EBF h\u1EC7 th\u1ED1ng
    Level & EXP\r\nThi\u1EBFt k\u1EBF c\xE1c Minigame\r\nPh\xE1t tri\u1EC3n gameplay
    t\u1ED5ng th\u1EC3\r\nL\u1EADp tr\xECnh h\u1EC7 th\u1ED1ng chi\u1EBFn \u0111\u1EA5u
    & k\u1EF9 n\u0103ng\r\nT\u1ED1i \u01B0u h\xF3a gameplay & c\xE2n b\u1EB1ng \u0111\u1ED9
    kh\xF3\r\n\u2014 \u2022 \u2014\r\nHI\u1EC6U \u1EE8NG H\xCCNH \u1EA2NH & CUTSCENE\r\nNguy\u1EC5n
    \u0110\u1ED7 \u0110\xECnh Khang (PS45894)\n\u2014 \u2022 \r\nThi\u1EBFt k\u1EBF
    VFX (Visual Effects)\r\nX\xE2y d\u1EF1ng Timeline & Cutscene\r\nHi\u1EC7u \u1EE9ng
    k\u1EF9 n\u0103ng & chi\u1EBFn \u0111\u1EA5u\r\nHi\u1EC7u \u1EE9ng chuy\u1EC3n
    c\u1EA3nh & m\xF4i tr\u01B0\u1EDDng\r\nVi\u1EBFt t\xE0i li\u1EC7u (Docs)\r\n\u2014
    \u2022 \r\n\xC2M THANH \r\nNg\xF4 Nh\u1EA5t Nghi\xEAm (PS45559)\n\u2014 \u2022
    \r\nThi\u1EBFt k\u1EBF SFX cho nh\xE2n v\u1EADt\r\nThi\u1EBFt k\u1EBF SFX cho
    qu\xE1i v\u1EADt\r\nThi\u1EBFt k\u1EBF SFX cho Minigame\r\nThi\u1EBFt k\u1EBF
    SFX cho Timeline & Cutscene\r\n\u2014 \u2022 \u2014\r\nH\u1ED6 TR\u1EE2 K\u1EF8
    THU\u1EACT & T\xC0I LI\u1EC6U\r\nL\xEA Duy Thanh (PS45753)\n\u2014 \u2022 \r\nThi\u1EBFt
    k\u1EBF Minimap\r\nH\u1ED7 tr\u1EE3 thi\u1EBFt k\u1EBF SFX\r\nX\xE2y d\u1EF1ng
    Qu\xE1i v\u1EADt\r\nH\u1ED7 tr\u1EE3 vi\u1EBFt t\xE0i li\u1EC7u (Docs)\r\n\u2014
    \u2022 \u2014\r\nVAI TR\xD2 B\u1ED4 SUNG\r\nH\u01AF\u1EDANG D\u1EAAN & C\u1ED0
    V\u1EA4N\n\u2014 \u2022 \r\nTh\u1EA7y Nguy\u1EC5n Tr\xED \u0110\u1ECBnh\r\nGi\xE1o
    vi\xEAn h\u01B0\u1EDBng d\u1EABn\r\n\u0110\u1ECBnh h\u01B0\u1EDBng ph\xE1t tri\u1EC3n
    d\u1EF1 \xE1n\r\nH\u1ED7 tr\u1EE3 k\u1EF9 thu\u1EADt & gi\u1EA3i \u0111\xE1p
    th\u1EAFc m\u1EAFc\r\n\u2014 \u2022 \u2014\r\nC\xD4NG NGH\u1EC6 S\u1EEC D\u1EE4NG\r\nGAME
    ENGINE\n\u2014 \u2022 \r\nUnity 6000.3.10f1\r\nRENDER PIPELINE\r\nUniversal Render
    Pipeline (URP)\r\nC\xD4NG C\u1EE4 H\u1ED6 TR\u1EE2\n\u2014 \u2022 \r\nCinemachine\r\nUnity
    Timeline\r\nDOTween\r\nUnity Input System\r\nTextMeshPro\r\nVisual Effect Graph\r\nUnity
    Particle SystemNH\u1EA0C N\u1EC0N & \xC2M THANH\r\nBGM (BACKGROUND MUSIC)\n\u2014
    \u2022 \r\nCh\u1EE7 \u0111\u1EC1 ch\xEDnh - \"Bi\xEAn ni\xEAn s\u1EED Ph\u01B0\u01A1ng
    B\u1EAFc\"\r\nCh\u1EE7 \u0111\u1EC1 chi\u1EBFn \u0111\u1EA5u - \"Kh\u1EDFi ngh\u0129a\"\r\nCh\u1EE7
    \u0111\u1EC1 Boss - \"\u0110\u1ED1i \u0111\u1EA7u v\u1EDBi \u0111\u1ECBnh m\u1EC7nh\"\r\nCh\u1EE7
    \u0111\u1EC1 kh\xE1m ph\xE1 - \"H\xE0nh tr\xECnh qua ArRealm\"\r\nCh\u1EE7 \u0111\u1EC1
    k\u1EBFt th\xFAc - \"B\xECnh minh c\u1EE7a m\u1ED9t v\u01B0\u01A1ng qu\u1ED1c\"\r\nSFX
    (SOUND EFFECTS)\r\n\xC2m thanh nh\xE2n v\u1EADt & k\u1EF9 n\u0103ng\r\n\xC2m
    thanh qu\xE1i v\u1EADt & Boss\r\n\xC2m thanh Minigame & M\xF4i tr\u01B0\u1EDDng\r\n\xC2m
    thanh UI & T\u01B0\u01A1ng t\xE1c\r\nThi\u1EBFt k\u1EBF & s\u1EA3n xu\u1EA5t
    b\u1EDFi nh\xF3m HEX\r\n\u2014 \u2022 \u2014\r\nL\u1EDCI C\u1EA2M \u01A0N\r\nL\u1EDCI
    C\u1EA2M \u01A0N \u0110\u1EB6C BI\u1EC6T\n\u2022 \r\nTr\u01B0\u1EDDng Cao \u0111\u1EB3ng
    FPT Polytechnic\r\nTh\u1EA7y Nguy\u1EC5n Tr\xED \u0110\u1ECBnh - Gi\xE1o vi\xEAn
    h\u01B0\u1EDBng d\u1EABn\r\nC\xE1c th\u1EA7y c\xF4 trong H\u1ED9i \u0111\u1ED3ng
    ph\u1EA3n bi\u1EC7n\r\nGia \u0111\xECnh & b\u1EA1n b\xE8 \u0111\xE3 lu\xF4n \u1EE7ng
    h\u1ED9\r\nC\xE1c b\u1EA1n \u0111\xE3 tham gia playtest v\xE0 \u0111\xF3ng g\xF3p
    \xFD ki\u1EBFn\r\n\r\nD\xD2NG K\u1EBET\r\n\u2014 \u2022 \u2014\r\n\"Chronicles
    of The North\"\r\nBi\xEAn ni\xEAn s\u1EED ph\u01B0\u01A1ng B\u1EAFc\r\n\u2014
    \u2022 \u2014\r\n\xA9 2026 Nh\xF3m HEX - FPT Polytechnic\r\nB\u1EA3o l\u01B0u
    m\u1ECDi quy\u1EC1n.\r\n--\u2014 \u2022 \u2014--\r\nC\u1EA3m \u01A1n b\u1EA1n
    \u0111\xE3 \u0111\u1ED3ng h\xE0nh c\xF9ng Eugeo\r\nTr\xEAn h\xE0nh tr\xECnh tr\u1EA3
    th\xF9 v\xE0 b\u1EA3o v\u1EC7 v\u01B0\u01A1ng qu\u1ED1c.\r\n----\u2014 \u2022
    \u2014----\r\n\r\n\r\n"
  m_isRightToLeft: 0
